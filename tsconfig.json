{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@env": ["./src/lib/env/index.ts"]
    },
    "types": ["unplugin-icons/types/react"]
  },
  "include": ["./src/**/*"],
  "exclude": ["./src/server.ts", "./src/instrumentation.ts"]
}
