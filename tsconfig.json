{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@env": ["./src/lib/env/index.ts"]
    },
    "types": ["unplugin-icons/types/react", "@types/bun"]
  },
  "include": [
    "./src/**/*",
    "./vite/**/*",
    "./vite.config.ts",
    "./vitest.config.ts",
    "./drizzle.config.ts"
  ],
  "exclude": ["./src/server.ts", "./src/instrumentation.ts"]
}
