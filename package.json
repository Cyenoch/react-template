{
  "name": "react-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "bunx @better-auth/cli generate --config src/core/api/auth/server.ts --output src/core/database/schema/better-auth.ts -y",
    "auth:migrate": "bunx @better-auth/cli migrate --config src/core/api/auth/server.ts -y",
    "test": "vitest",
    "up": "bunx -b taze major -w"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/sdk-trace-node": "^2.5.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@orpc/client": "^1.13.4",
    "@orpc/contract": "^1.13.4",
    "@orpc/otel": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.158.0",
    "@tanstack/react-router-devtools": "^1.158.0",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.158.0",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "2.1.7",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/mingcute": "^1.2.7",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/nitro-v2-vite-plugin": "^1.154.7",
    "@types/bun": "^1.3.8",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260204.1",
    "@vitejs/plugin-react": "^5.1.3",
    "drizzle-kit": "^0.31.8",
    "happy-dom": "^20.5.0",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "rolldown": "^1.0.0-rc.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "npm:rolldown-vite@latest",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "packageManager": "bun@1.3.8"
}
