{
  "name": "react-template",
  "type": "module",
  "private": true,
  "module": "index.ts",
  "scripts": {
    "dev": "bun -b vite dev --port 3000",
    "build": "bun -b vite build",
    "start": "bun -b .output/server/index.mjs",
    "format": "biome format --write",
    "lint": "oxlint --fix",
    "typecheck": "bun -b tsc --noEmit",
    "up": "bunx taze major -x tailwindcss -x tailwind-merge -w",
    "generate": "bunx -b drizzle-kit generate",
    "migrate": "bun migrate.ts",
    "better-auth:generate": "bunx -b @better-auth/cli generate --config src/lib/auth/index.ts --output src/lib/database/schema/better-auth.ts -y"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@tanstack/react-router": "^1.130.12",
    "@tanstack/react-router-devtools": "^1.130.13",
    "@tanstack/react-router-with-query": "^1.130.12",
    "@tanstack/react-start": "^1.130.15",
    "better-auth": "^1.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.45.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.4",
    "lucide-react": "^0.537.0",
    "next-themes": "^0.4.6",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "regenerator-runtime": "^0.14.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.6",
    "uuid": "^11.1.0",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@iconify-json/mingcute": "^1.2.3",
    "@iconify-json/svg-spinners": "^1.2.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/bun": "latest",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-oxc": "^0.4.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.4",
    "oxlint": "^1.10.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "unplugin-auto-import": "^20.0.0",
    "unplugin-icons": "^22.2.0",
    "vite": "^7.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@latest"
  }
}
