    "@svgr/plugin-jsx": "^8.1.0",
    "@types/bun": "latest",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.2",
    "oxlint": "^1.3.0",
