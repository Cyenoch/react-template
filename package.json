{
  "name": "react-template",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "turbo format",
    "db:generate": "bun --filter=@workspace/database generate",
    "db:migrate": "bun --filter=@workspace/database migrate",
    "auth:generate": "bun --filter=@workspace/auth bunx better-auth generate",
    "auth:migrate": "bun --filter=@workspace/auth bunx better-auth migrate",
    "up": "bunx -b taze major -w"
  },
  "catalog": {
    "typescript": "^5.8.3",
    "zod": "^4.3.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "pino": "^10.1.1",
    "pino-pretty": "^13.1.3",
    "better-auth": "^1.4.12",
    "sonner": "^2.0.7",
    "@opentelemetry/api": "^1.9.0",
    "@orpc/client": "^1.13.2",
    "@orpc/otel": "^1.13.2",
    "@orpc/server": "^1.13.2",
    "@tanstack/react-start": "^1.149.2",
    "@tanstack/react-router": "^1.147.3",
    "@tanstack/react-query": "^5.90.16",
    "tailwindcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  }
}
