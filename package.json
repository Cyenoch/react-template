{
  "name": "react-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.8.3",
      "zod": "^4.3.5",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "@types/react": "^19.2.8",
      "@types/react-dom": "^19.2.3",
      "pino": "^10.1.1",
      "pino-pretty": "^13.1.3",
      "better-auth": "^1.4.12",
      "sonner": "^2.0.7",
      "@opentelemetry/api": "^1.9.0",
      "@orpc/client": "^1.13.2",
      "@orpc/otel": "^1.13.2",
      "@orpc/server": "^1.13.2",
      "@tanstack/react-start": "^1.149.2",
      "@tanstack/react-router": "^1.147.3",
      "@tanstack/react-query": "^5.90.16",
      "tailwindcss": "^4.1.18",
      "@tailwindcss/vite": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "dotenv -c -- turbo dev",
    "build": "dotenv -c -- turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "turbo format",
    "db:generate": "dotenv -c -- bun --filter=@workspace/database generate",
    "db:migrate": "dotenv -c -- bun --filter=@workspace/database migrate",
    "auth:generate": "dotenv -c -- bun --filter=@workspace/api auth:generate",
    "auth:migrate": "dotenv -c -- bun --filter=@workspace/api auth:migrate",
    "up": "bunx -b taze major -w"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.5"
}
