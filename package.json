{
  "name": "react-template",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "bun -b vite dev --port 3000",
    "build": "bun -b vite build",
    "analyzer": "bunx -b vite-bundle-analyzer",
    "start": "bun -b .output/server/index.mjs",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "up": "bunx -b taze major -w",
    "generate": "bun -b drizzle-kit generate",
    "migrate": "bun -b drizzle-kit migrate",
    "better-auth:generate": "bun -b @better-auth/cli generate --config src/lib/auth/server.ts --output src/database/schema/better-auth.ts -y"
