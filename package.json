{
  "name": "react-template",
  "type": "module",
  "private": true,
  "module": "index.ts",
  "scripts": {
    "dev": "bun -b vite dev --port 3000",
    "build": "bun -b vite build",
    "analyzer": "bunx -b vite-bundle-analyzer",
    "start": "bun -b .output/server/index.mjs",
    "format": "biome format --write",
    "lint": "oxlint --fix",
    "typecheck": "bun -b tsc --noEmit",
    "up": "bunx taze major -w",
    "generate": "bunx -b drizzle-kit generate",
    "migrate": "bunx -b drizzle-kit migrate",
    "better-auth:generate": "bunx -b @better-auth/cli generate --config src/lib/auth/server.ts --output src/database/schema/better-auth.ts -y"
  },
