{
  "name": "react-template",
  "type": "module",
  "private": true,
  "module": "index.ts",
  "scripts": {
    "dev": "bun -b vite dev --port 3000",
    "build": "bun -b vite build",
    "analyzer": "bunx -b vite-bundle-analyzer",
    "start": "bun -b .output/server/index.mjs",
    "format": "biome format --write",
    "lint": "oxlint --fix",
    "typecheck": "bun -b tsc --noEmit",
    "up": "bunx taze major -x tailwindcss -x tailwind-merge -w",
    "generate": "bunx -b drizzle-kit generate",
    "migrate": "bunx -b drizzle-kit migrate",
    "better-auth:generate": "bunx -b @better-auth/cli generate --config src/auth/server.ts --output src/database/schema/better-auth.ts -y"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@heroui/react": "^2.8.4",
    "@hookform/resolvers": "^5.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.1",
    "@opentelemetry/instrumentation-pg": "^0.58.0",
    "@opentelemetry/instrumentation-pino": "^0.52.0",
    "@opentelemetry/instrumentation-redis": "^0.54.1",
    "@opentelemetry/instrumentation-runtime-node": "^0.19.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@orpc/client": "^1.9.1",
    "@orpc/otel": "^1.9.1",
    "@orpc/server": "^1.9.1",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-router": "^1.132.23",
    "@tanstack/react-router-devtools": "^1.132.23",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.132.24",
    "better-auth": "^1.3.23",
    "date-fns": "^4.1.0",
    "defu": "^6.1.4",
    "drizzle-orm": "^0.44.5",
    "framer-motion": "^12.23.22",
    "pg": "^8.16.3",
    "pino": "^9.12.0",
    "pino-pretty": "^13.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "superjson": "^2.2.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.4",
    "@iconify-json/mingcute": "^1.2.5",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.2.23",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.5",
    "oxlint": "^1.18.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-icons": "^22.3.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
