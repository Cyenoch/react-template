{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**"
      ],
      "outputs": ["dist/**", ".output/**"],
      "env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "../../.oxlintrc.json"],
      "outputs": []
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "../../.oxfmtrc.json"],
      "outputs": [],
      "cache": false
    },
    "generate": {
      "inputs": ["src/schema/**", "drizzle.config.ts"],
      "outputs": ["drizzle/**"],
      "cache": false
    },
    "migrate": {
      "cache": false
    }
  }
}
